{
  "name": "AudioAnalyzer",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env DEBUG=AudioAnalyzer:* node --watch ./bin/www",
    "logs": "pm2 logs AudioAnalyzer",
    "stop": "pm2 stop AudioAnalyzer",
    "restart": "cross-env NODE_ENV=production pm2 restart AudioAnalyzer --update-env",
    "start": "cross-env NODE_ENV=production pm2 start ./bin/www --name AudioAnalyzer"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^18.0.9",
    "ejs": "^6.0.1",
    "express": "^4.22.3",
    "express-ejs-layouts": "^2.5.1",
    "http-errors": "~1.6.3",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
